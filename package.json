{
  "name": "synthpass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "frontend:dev": "next dev frontend --turbopack",
    "frontend:build": "next build frontend",
    "frontend:start": "next start frontend",
    "backend:dev": "node --watch backend/src/server.js",
    "backend:start": "node backend/src/server.js",
    "backend:migrate": "node backend/src/db/migrate-run.js",
    "worker:start": "node backend/src/workers/provenanceWorker.js",
    "worker:dev": "node --watch backend/src/workers/provenanceWorker.js",
    "db:start": "docker compose up -d postgres redis",
    "db:stop": "docker compose stop postgres redis",
    "db:psql": "docker compose exec postgres psql -U makerspace -d makerspace",
    "check:local": "node scripts/check-local-dev.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "eslint --config frontend/eslint.config.mjs frontend --ignore-pattern '**/.next/**'",
    "lint:backend": "eslint --config backend/eslint.config.mjs backend/src backend/test",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "test:identity": "node --test backend/test/identity.test.js",
    "test:workspace": "node --test backend/test/workspace.test.js",
    "test:media": "node --test backend/test/media.test.js",
    "test:contracts": "node --test backend/test/contracts.test.js",
    "test:provenance": "node --test backend/test/provenance.test.js",
    "test:paypal": "node --test backend/test/paypal.test.js",
    "test:payroll": "node --test backend/test/payroll.test.js",
    "test:media:live": "LIVE_B2_500MB=1 node --test backend/test/media-live.test.js",
    "test:redis": "node --test backend/test/redis.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@arcjet/next": "^1.5.0",
    "@arcjet/node": "^1.5.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@contentauth/c2pa-node": "^0.9.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@sentry/nextjs": "^10.60.0",
    "@sentry/node": "^10.60.0",
    "@tanstack/react-query": "^5.96.2",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embla-carousel-react": "^8.5.2",
    "express": "^4.21.2",
    "firebase": "^9.14.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.471.2",
    "next": "^16.3.8",
    "next-auth": "^4.24.11",
    "pg": "^8.14.1",
    "query-string": "^9.1.1",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^18.3.1",
    "react-calendar-heatmap": "^1.9.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "redis": "^6.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.3.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.173.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19",
    "@types/three": "^0.173.0",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
